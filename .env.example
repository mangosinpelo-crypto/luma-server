# ═══════════════════════════════════════════════════════════
# LUMA SERVER — PLANTILLA DE ENTORNO (.env.example)
# Copia este archivo a .env y completa los valores correspondientes
# ═══════════════════════════════════════════════════════════

PORT=3001
FRONTEND_URL=https://tu-dominio-frontend.com

# ── PROVEEDOR DE IA ────────────────────────────────────────
# Opción 1: DeepInfra (Recomendado)
DEEPINFRA_API_KEY=tu_deepinfra_api_key

# Opción 2: OpenRouter
OPENROUTER_API_KEY=tu_openrouter_api_key

# Opción 3: Groq
GROQ_API_KEY=tu_groq_api_key

# Modelos recomendados:
FREE_MODEL=mistralai/Mistral-Nemo-Instruct-2407
PREMIUM_MODEL=NousResearch/Hermes-3-Llama-3.1-70B

# ── SUPABASE (Base de datos y Autenticación) ───────────────
SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_supabase_service_role_key

# ── STRIPE (Pagos y Suscripciones) ─────────────────────────
STRIPE_SECRET_KEY=sk_live_o_test_key
STRIPE_WEBHOOK_SECRET=whsec_tu_webhook_secret
STRIPE_PRICE_PREMIUM=price_...
STRIPE_PRICE_OBSESION=price_...
